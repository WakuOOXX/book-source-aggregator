<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NovelDownloader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NovelDownloader.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 设计令牌 (Light/Dark ThemeDictionaries)。相对 URI, 免打包下不依赖 MRT/PRI。 -->
                <ResourceDictionary Source="Themes/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局转换器 -->
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BlockedToForegroundConverter x:Key="BlockedToForegroundConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

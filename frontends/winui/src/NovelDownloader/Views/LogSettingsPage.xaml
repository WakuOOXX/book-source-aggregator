<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NovelDownloader.Views.LogSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="{ThemeResource PageMargin}">
            <TextBlock Text="日志与设置"
                       FontFamily="{ThemeResource DisplayFontFamily}"
                       FontSize="{ThemeResource FontSizeTitleLarge}"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextPrimaryBrush}" />
            <TextBlock Text="外观、数据与关于信息。"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="{ThemeResource PageMargin}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">

                <!-- ============ 外观: 主题三选 ============ -->
                <Border Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Padding="{ThemeResource CardPadding}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="外观"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="主题"
                                       FontSize="{ThemeResource FontSizeCaption}"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <!--
                              主题三选用普通 RadioButton + Checked 事件: RadioButtons 控件的
                              SelectionChanged 在程序化选中 (含 UIA) 时不可靠, 而 RadioButton.Checked
                              在真实点击与程序化 IsChecked=true 两条路径都会触发。
                            -->
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:Name="ThemeSystemRadio"
                                             Content="跟随系统"
                                             GroupName="ThemeGroup"
                                             Tag="System"
                                             AutomationProperties.Name="跟随系统主题"
                                             Checked="ThemeRadio_Checked" />
                                <RadioButton x:Name="ThemeLightRadio"
                                             Content="浅色"
                                             GroupName="ThemeGroup"
                                             Tag="Light"
                                             AutomationProperties.Name="浅色主题"
                                             Checked="ThemeRadio_Checked" />
                                <RadioButton x:Name="ThemeDarkRadio"
                                             Content="深色"
                                             GroupName="ThemeGroup"
                                             Tag="Dark"
                                             AutomationProperties.Name="深色主题"
                                             Checked="ThemeRadio_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 关于 ============ -->
                <Border Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Padding="{ThemeResource CardPadding}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="关于"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="应用版本"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="后端版本"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BackendVersion}"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="JS 引擎"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JsEngineStatus}"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="后端摘要"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BackendSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 数据 ============ -->
                <Border Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Padding="{ThemeResource CardPadding}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="数据"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="数据存储目录"
                                       FontSize="{ThemeResource FontSizeCaption}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding DataDirDisplay}"
                                       FontFamily="{ThemeResource MonoFontFamily}"
                                       FontSize="{ThemeResource FontSizeCaption}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="书源文件、下载的书、登录头都存在这里。更改目录时这些内容会一起搬过去。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="OpenDataDirButton"
                                    Content="打开数据目录"
                                    MinWidth="0"
                                    Padding="14,6"
                                    IsEnabled="{Binding CanEdit}"
                                    AutomationProperties.Name="打开数据目录"
                                    Click="OpenDataDirButton_Click" />
                            <Button x:Name="ChangeDataDirButton"
                                    Content="更改目录…"
                                    MinWidth="0"
                                    Padding="14,6"
                                    IsEnabled="{Binding CanEdit}"
                                    AutomationProperties.Name="更改数据存储目录"
                                    Click="ChangeDataDirButton_Click" />
                        </StackPanel>
                        <TextBlock Text="{Binding BusyHint}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="清除缓存"
                                       FontSize="{ThemeResource FontSizeCaption}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Text="删掉校验留下的中间文件和校验记录, 连同上次的勾选一起清空, 需要重新校验。书源文件、登录头、下载的书都不动。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button x:Name="ClearCacheButton"
                                    Content="清除缓存"
                                    HorizontalAlignment="Left"
                                    MinWidth="0"
                                    Padding="14,6"
                                    IsEnabled="{Binding CanEdit}"
                                    AutomationProperties.Name="清除缓存"
                                    Click="ClearCacheButton_Click" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="清除数据"
                                       FontSize="{ThemeResource FontSizeCaption}"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock Text="删掉登录头、全部书源文件和运行记录, 书源恢复成内置的那一份, 相当于回到刚装好的状态。下载的书保留。"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button x:Name="ClearDataButton"
                                    Content="清除数据"
                                    HorizontalAlignment="Left"
                                    MinWidth="0"
                                    Padding="14,6"
                                    IsEnabled="{Binding CanEdit}"
                                    AutomationProperties.Name="清除数据"
                                    Click="ClearDataButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

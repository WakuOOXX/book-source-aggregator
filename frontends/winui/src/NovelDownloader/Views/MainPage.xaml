<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NovelDownloader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:NovelDownloader.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部: 大搜索框 + 搜索域 + 搜索/停止 ==================== -->
        <Grid Grid.Row="0" Margin="24,16,24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <muxc:AutoSuggestBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Height="{ThemeResource SearchBoxHeight}"
                                 VerticalContentAlignment="Center"
                                 FontSize="{ThemeResource FontSizeSearchBox}"
                                 FontFamily="{ThemeResource BodyFontFamily}"
                                 QueryIcon="Find"
                                 PlaceholderText="输入书名 / 作者 …"
                                 AutomationProperties.Name="搜索关键词"
                                 Text="{Binding Keyword, Mode=TwoWay}"
                                 QuerySubmitted="SearchBox_QuerySubmitted" />

            <muxc:ComboBox x:Name="DomainCombo"
                           Grid.Column="1"
                           MinWidth="110"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="搜索域"
                           ItemsSource="{Binding Domains}"
                           SelectedItem="{Binding Domain, Mode=TwoWay}" />

            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="{Binding SearchButtonText}"
                    MinWidth="96"
                    AutomationProperties.Name="开始搜索"
                    Click="SearchButton_Click" />
        </Grid>

        <!-- ==================== 选项行: 三个 CheckBox + 书源分组 ==================== -->
        <Grid Grid.Row="1" Margin="24,0,24,8">
            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <CheckBox x:Name="FuzzyCheck" Content="模糊搜索" MinWidth="0"
                          IsChecked="{Binding Fuzzy, Mode=TwoWay}" />
                <CheckBox x:Name="RelatedOnlyCheck" Content="只看相关" MinWidth="0"
                          IsChecked="{Binding RelatedOnly, Mode=TwoWay}" />
                <CheckBox x:Name="DeepOnlyCheck" Content="只搜试搜通过源" MinWidth="0"
                          IsChecked="{Binding DeepOnly, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="全选" MinWidth="0" Click="SelectAll_Click" />
                <Button Content="反选" MinWidth="0" Click="InvertSelection_Click" />
                <Button Content="清空" MinWidth="0" Click="ClearSelection_Click" />
                <TextBlock Text="书源分组:"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <ComboBox x:Name="SourceGroupCombo"
                          MinWidth="160"
                          ItemsSource="{Binding SourceGroups}"
                          PlaceholderText="全部"
                          AutomationProperties.Name="书源分组"
                          SelectedItem="{Binding SourceGroup, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 结果计数行 ==================== -->
        <Grid Grid.Row="2" Margin="24,0,24,8">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource AccentLightBrush}"
                        CornerRadius="10"
                        Padding="10,3">
                    <TextBlock Text="{Binding HitBadgeText}"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource AccentTextBrush}" />
                </Border>
                <TextBlock Text="{Binding SelectedBadgeText}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ==================== 结果区: WinUI 表格 = 定宽表头 Grid + ListView(ItemTemplate 定宽 Grid) ====================
             注: 旧版误用了 WPF 的表格列 API, WinUI 3 (UWP XAML) 里根本没有那些类型, 这是 XamlCompiler 失败根因。
             WinUI 的表格做法: 用「与行模板列宽逐列对齐的表头 Grid」+「ListView 的 ItemTemplate 内嵌定宽 Grid」。
             表头与行的 Padding / ColumnSpacing / 各列宽度必须完全一致才能横平竖直;
             通过 ItemContainerStyle 把 ListViewItem 默认内边距归零, 保证两者左起点一致。 -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 表头行: 等比列宽 2.6*/1*/0.9*/1.5*/1.2* (WinUI 的 ColumnDefinition 不支持 MinWidth) 与下方 ItemTemplate 逐列一致 -->
            <Border Grid.Row="0"
                    Background="{ThemeResource CardSoftBrush}"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Padding="12,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="书名" FontWeight="SemiBold"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="作者" FontWeight="SemiBold"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="分类" FontWeight="SemiBold"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="最新章节" FontWeight="SemiBold"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="书源" FontWeight="SemiBold"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <!-- 框选提示: 三级色小字贴表头右侧 -->
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="5"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="Ctrl 加选 · Shift 连选 · 空白处拖动框选"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- 行区: ListView + ItemTemplate 定宽 Grid (列宽与表头逐列一致)。
                 ItemContainerTransitions 置空: 默认模板含 AddDeleteThemeTransition,
                 命中洪流时每条 Add 都开一个入场动画 → UI 线程被动画合成占满。
                 虚拟化仍由默认 ItemsPanel (VirtualizingStackPanel) 负责, ItemTemplate
                 为 Border>Grid 不破坏回收。 -->
            <!-- 行区 + 框选覆盖层: ListView 自带 Extended 语义 (Ctrl/Shift/在行上拖动连续选),
                 空白区按下拖动的「资源管理器式框选」由代码后置在 MarqueeCanvas 上画绿框,
                 覆盖层 IsHitTestVisible=False 不吃命中, 只负责显示绿框。 -->
            <Grid Grid.Row="1">
                <ListView x:Name="ResultsView"
                          Margin="0"
                          SelectionMode="Extended"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding Hits}"
                          ToolTipService.ToolTip="Ctrl 加选 · Shift 连选 · 空白处拖动框选"
                          SelectionChanged="ResultsView_SelectionChanged">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HitItem">
                        <Border BorderBrush="{ThemeResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                AutomationProperties.Name="{Binding Name}"
                                AutomationProperties.HelpText="{Binding SubtitleLine}">
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                           FontSize="{ThemeResource FontSizeBody}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Author}" VerticalAlignment="Center"
                                           FontSize="{ThemeResource FontSizeBody}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"
                                           FontSize="{ThemeResource FontSizeBody}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding LastChapter}" VerticalAlignment="Center"
                                           FontSize="{ThemeResource FontSizeBody}"
                                           Foreground="{ThemeResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding SourceName}" VerticalAlignment="Center"
                                           FontSize="{ThemeResource FontSizeBody}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Blocked, Converter={StaticResource BlockedToForegroundConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>

                <Canvas x:Name="MarqueeCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="MarqueeRect"
                               Visibility="Collapsed"
                               Stroke="{ThemeResource MarqueeBrush}"
                               StrokeThickness="2"
                               Fill="{ThemeResource MarqueeFillBrush}"
                               RadiusX="2" RadiusY="2" />
                </Canvas>
            </Grid>

            <!-- 空结果占位 (仅空闲且无结果时浮在行区中央) -->
            <TextBlock x:Name="EmptyHint" Grid.Row="1"
                       Text="还没有结果 · 输入关键词后回车或点「搜索」"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextTertiaryBrush}"
                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <!-- ==================== 底部吸底操作栏 ==================== -->
        <Border Grid.Row="4"
                Margin="24,12,24,0"
                Padding="12"
                Background="{ThemeResource CardBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource CardCornerRadius}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="DownloadButton"
                            Content="{Binding DownloadButtonText}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding CanDownload}"
                            Click="Download_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- ComboBoxItem 的 Content 为字符串; 用 SelectedValuePath=Content + SelectedValue
                         绑定, 让 VM 上的 ExportFormat / DownloadMode 收到的是字符串而非 ComboBoxItem 对象。 -->
                    <ComboBox x:Name="FormatCombo"
                              MinWidth="120"
                              ToolTipService.ToolTip="自动: 先按 EPUB 导出, 书源不支持时改存 TXT。"
                              AutomationProperties.Name="导出格式"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding ExportFormat, Mode=TwoWay}">
                        <ComboBoxItem Content="自动" />
                        <ComboBoxItem Content="EPUB" />
                        <ComboBoxItem Content="TXT" />
                    </ComboBox>
                    <ComboBox x:Name="CombineCombo"
                              MinWidth="140"
                              ToolTipService.ToolTip="万里挑一: 选中的书依次换源试下, 第一本成功即停。全部下载: 每本选中的书都各存一个文件。"
                              AutomationProperties.Name="下载模式"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding DownloadMode, Mode=TwoWay}">
                        <ComboBoxItem Content="万里挑一" />
                        <ComboBoxItem Content="全部下载" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 状态栏 ==================== -->
        <Grid Grid.Row="5" Margin="24,8,24,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <muxc:ProgressRing IsActive="{Binding IsSearching}"
                                   Width="18" Height="18"
                                   Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock x:Name="StatusText"
                           Text="{Binding SearchProgress}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="StatusCounter"
                       Text="{Binding BackendStatus}"
                       VerticalAlignment="Center"
                       FontFamily="{ThemeResource MonoFontFamily}"
                       FontSize="{ThemeResource FontSizeCaption}"
                       Foreground="{ThemeResource TextTertiaryBrush}" />
        </Grid>
    </Grid>
</Page>

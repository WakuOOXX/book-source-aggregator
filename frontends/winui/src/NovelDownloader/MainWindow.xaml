<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NovelDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="小说下载器">

    <!-- 根 Grid: 顶部自定义 TitleBar (Mica 延伸) + 下方 NavigationView 壳 -->
    <Grid x:Name="RootGrid" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 自定义 TitleBar (ExtendsContentIntoTitleBar) ============ -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="{ThemeResource TitleBarHeight}"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 与 NavigationView 的 LeftCompact 图标栏对齐 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0"
                        Spacing="10">
                <FontIcon Glyph="&#xE8F1;"
                          FontSize="16"
                          Foreground="{ThemeResource AccentBrush}" />
                <TextBlock Text="小说下载器"
                           VerticalAlignment="Center"
                           FontFamily="{ThemeResource BodyFontFamily}"
                           FontSize="13"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ============ NavigationView 壳 ============ -->
        <muxc:NavigationView x:Name="NavView"
                             Grid.Row="1"
                             PaneDisplayMode="LeftCompact"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             IsPaneToggleButtonVisible="False"
                             SelectionFollowsFocus="Disabled"
                             SelectionChanged="NavView_SelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="搜索" Tag="search" ToolTipService.ToolTip="搜索">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="书源" Tag="sources" ToolTipService.ToolTip="书源管理">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="登录头" Tag="auth" ToolTipService.ToolTip="登录头管理">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="日志" Tag="log" ToolTipService.ToolTip="日志">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="设置" Tag="settings" ToolTipService.ToolTip="设置">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <!-- 右侧内容 Frame: 页面切换 (默认 EntranceNavigationTransitionInfo) -->
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
